# ==============================================================================
# NexMeet Environment Configuration Template
# Copy this file to .env.local for local development, or add to Vercel Settings
# ==============================================================================

# Google Calendar & Meet OAuth 2.0 Credentials
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth Redirect URI
# Local: http://localhost:3000/api/auth/callback/google
# Vercel: https://your-project.vercel.app/api/auth/callback/google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
